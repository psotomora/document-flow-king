<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FlujoEfectivo.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.33.5</Version>
    <AssemblyVersion>1.33.5.0</AssemblyVersion>
    <FileVersion>1.33.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- La configuración productiva contiene llaves propias del servidor.
       Nunca debe ser sobrescrita por una publicación desde Git. -->
  <ItemGroup>
    <Content Update="appsettings.Production.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
