<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación de la API .NET 8 en IIS (requiere ASP.NET Core Hosting Bundle).
  Este archivo se copia automáticamente al publicar con:
      dotnet publish -c Release -o C:\inetpub\FlujoEfectivoApi
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- WebDAV bloquea POST/PUT/DELETE en IIS: se quita para la API. -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <!-- Evita que IIS reemplace las respuestas de error de la API por páginas HTML. -->
      <httpErrors existingResponse="PassThrough" errorMode="Detailed" />

      <aspNetCore processPath="dotnet"
                  arguments=".\FlujoEfectivo.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Muestra el motivo real cuando la API no logra iniciar (error 500.30). -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="true" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <!-- Instantáneas del agente (facturas) pueden superar el límite de 28 MB de IIS;
             la API vuelve a limitar a 30 MB todos los demás endpoints. -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
